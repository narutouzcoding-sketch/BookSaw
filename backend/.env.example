# ==============================================================================
# BooksCatalog (Booksaw) — Environment Variables
# ==============================================================================
# Bu faylni .env ga nusxalab, qiymatlarni to'ldiring.
# .env HECH QACHON git'ga push qilinmasligi kerak!
# ==============================================================================

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=bookscatalog
DB_USER=books_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF — vergul bilan ajratilgan originlar
# Production uchun: CORS_ORIGINS=https://booksaw.uz,https://www.booksaw.uz
# Bo'sh qoldirsa, dev uchun localhost portlari ishlatiladi.
CORS_ORIGINS=
CSRF_ORIGINS=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_CHAT_ID=your-chat-id

# Frontend URL (OAuth redirect uchun)
FRONTEND_URL=http://localhost:5173

# Email (production uchun)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@booksaw.uz
